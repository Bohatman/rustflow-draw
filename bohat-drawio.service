[Unit]
Description=Bohat Draw.io 100% Rust Production Server (WASM + WebSocket Co-Op on Port 6129)
After=network.target

[Service]
Type=simple
User=bohat
WorkingDirectory=/home/bohat/projects/rustflow-draw
Environment=PORT=6129
Environment=BOHAT_STATIC_DIR=/home/bohat/projects/rustflow-draw/apps/studio/dist
EnvironmentFile=-/home/bohat/projects/rustflow-draw/.env
ExecStart=/bin/bash /home/bohat/projects/rustflow-draw/start.sh
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
